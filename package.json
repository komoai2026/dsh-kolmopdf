{
  "name": "@kolmopdf/dsh-kolmopdf",
  "version": "1.1.1",
  "description": "Official KolmoPDF plugin for DeepSeek Harness: high-fidelity PDF to Markdown/OCR (formulas & tables), layout-preserving PDF translation, and Markdown export to DOCX, PDF, HTML, and LaTeX.",
  "author": "KolmoPDF <support@kolmopdf.com>",
  "icon": "./assets/icon.png",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./icon": "./assets/icon.png",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "kolmopdf": "lib/cli.js"
  },
  "files": [
    "lib",
    "assets",
    "locale",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "examples",
    "cordis.patch.yml"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsup && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:host": "node scripts/host-mix-test.mjs",
    "test:client": "node scripts/client-loader-test.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "packageManager": "pnpm@11.1.3",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "cordis-plugin",
    "kolmopdf",
    "pdf",
    "pdf-to-markdown",
    "pdf-parser",
    "ocr",
    "pdf-translation",
    "bilingual-pdf",
    "markdown",
    "latex",
    "docx",
    "formula",
    "table-extraction",
    "document-processing"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-0 || ^0.2.3-0 || ^0.2.4-0 || ^0.2.5-0"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "yaml": "^2.8.2",
    "yauzl": "^3.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-api-remotes": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-0 || ^0.2.3-0 || ^0.2.4-0 || ^0.2.5-0",
    "@deepseek-ai/dsh-atomic-write": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-0 || ^0.2.3-0 || ^0.2.4-0 || ^0.2.5-0",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-0 || ^0.2.3-0 || ^0.2.4-0 || ^0.2.5-0",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-0 || ^0.2.3-0 || ^0.2.4-0 || ^0.2.5-0",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-0 || ^0.2.3-0 || ^0.2.4-0 || ^0.2.5-0",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-0 || ^0.2.3-0 || ^0.2.4-0 || ^0.2.5-0",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-0 || ^0.2.3-0 || ^0.2.4-0 || ^0.2.5-0",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-0 || ^0.2.3-0 || ^0.2.4-0 || ^0.2.5-0",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-0 || ^0.2.3-0 || ^0.2.4-0 || ^0.2.5-0",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-0 || ^0.2.3-0 || ^0.2.4-0 || ^0.2.5-0",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1 || ^0.2.1-0 || ^0.2.2-0 || ^0.2.3-0 || ^0.2.4-0 || ^0.2.5-0",
    "@deepseek-ai/schemastery": "^3.19.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-api-remotes": { "optional": true },
    "@deepseek-ai/dsh-atomic-write": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-ui-primitives": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-credentials": { "optional": true },
    "@deepseek-ai/dsh-home-paths": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^22.15.0",
    "@types/react": "~18.3.1",
    "@types/yauzl": "^2.10.3",
    "esbuild": "^0.28.2",
    "react": "^18.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/komoai2026/dsh-kolmopdf.git"
  },
  "homepage": "https://www.kolmopdf.com",
  "bugs": {
    "url": "https://github.com/komoai2026/dsh-kolmopdf/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
